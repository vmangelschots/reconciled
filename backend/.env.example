# Copy this to .env (for local, non-Docker runs) and fill in real values.
# docker-compose.yml supplies these to the container directly; this file
# is only needed if you run manage.py outside Docker.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=reconciled
DB_USER=reconciled
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

BUDGET_APP_USERNAME=change-me
BUDGET_APP_PASSWORD=change-me

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI categorization - see the root .env.example.
ANTHROPIC_API_KEY=
