# Copy to .env before running `docker compose up`. docker-compose reads
# this file automatically and injects these into the backend container.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=reconciled
DB_USER=reconciled
DB_PASSWORD=change-me

BUDGET_APP_USERNAME=change-me
BUDGET_APP_PASSWORD=change-me

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Optional: guess categories for new payees with OpenAI. Leave the key
# empty to use only your own history. Payee names, notes and amounts are
# sent to OpenAI; account names, dates and balances never are.
OPENAI_API_KEY=
# AI_CATEGORIZATION_ENABLED=true
# AI_CATEGORIZATION_MODEL=gpt-6-luna
# AI_CATEGORIZATION_DEADLINE=20

# Optional: sync bank lines through Enable Banking. Leave these empty to
# keep importing files only. The key may be on one line with \n for newlines.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
