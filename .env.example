# Copy to .env before running `docker compose up`. docker-compose reads
# this file automatically and injects these into the backend container.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=reconciled
DB_USER=reconciled
DB_PASSWORD=change-me

BUDGET_APP_USERNAME=change-me
BUDGET_APP_PASSWORD=change-me

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
